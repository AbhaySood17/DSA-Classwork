class Solution {
public:
    bool canFinish(int n, vector<vector<int>>& prerequisites) {
        
        vector<vector<int>>adj(n);
        for(auto i:prerequisites){
            int u = i[0];
            int v = i[1];
            adj[u].push_back(v);
        }

        vector<int>indeg(n,0);

        for(int i=0;i<n;i++){
            for(auto i:adj[i]){
                indeg[i]++;
            }
        }

        queue<int>q;

        for(int i=0;i<n;i++){
            if(indeg[i]==0){
                q.push(i);
            }
        }

        int cnt=0;
        while(!q.empty()){
            int node= q.front();
            q.pop();

            cnt++;
            for(auto i:adj[node]){
                indeg[i]--;
                if(indeg[i]==0)q.push(i);
            }
        }

        if(cnt==n)return true;
        return false;


    }
};
