class Solution {
public:
    vector<int> findOrder(int n, vector<vector<int>>& prerequisites) {
        vector<vector<int>>adj(n);
        for(auto i:prerequisites){
            int u = i[0];
            int v = i[1];
            adj[v].push_back(u);
        }

        vector<int>indeg(n,0);

        for(int i=0;i<n;i++){
            for(auto i:adj[i]){
                indeg[i]++;
            }
        }

        queue<int>q;

        for(int i=0;i<n;i++){
            if(indeg[i]==0){
                q.push(i);
            }
        }

        vector<int>topo;
        while(!q.empty()){
            int node= q.front();
            q.pop();

            topo.push_back(node);
            for(auto i:adj[node]){
                indeg[i]--;
                if(indeg[i]==0)q.push(i);
            }
        }

        if(topo.size()==n)return topo;
        return {};



    }
};
