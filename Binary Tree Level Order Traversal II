/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public List<List<Integer>> levelOrderBottom(TreeNode root) {
        List<List<Integer>> ans = new ArrayList<>();
        if(root==null)return ans ;
        Queue<TreeNode> qy = new LinkedList<>();
        qy.add(root);

        while(!qy.isEmpty()){
            int n =qy.size();
            List<Integer> level = new ArrayList<>();
            for(int i=0;i<n;i++){
                TreeNode temp = qy.poll();
                level.add(temp.val);
                if(temp.left!=null)qy.add(temp.left);
                if(temp.right!=null)qy.add(temp.right);
            }
            ans.add(0,level);
        }
        return ans ;
    }
}
